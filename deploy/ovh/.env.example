# انسخه إلى deploy/ovh/.env واملأه على الخادم — لا يُلتزم ولا يُرسل (0005 §١٤٠).

# النطاق وبريد شهادة HTTPS
DOMAIN=app.example.com
ACME_EMAIL=you@example.com

# قاعدة البيانات — كلمتان طويلتان عشوائيتان: openssl rand -base64 32
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Django — openssl rand -base64 48
DJANGO_SECRET_KEY=

# رمز التحقق (docs/research/otp-providers-sudan.md) — الغائب يعطّل قناته وحدها
STING_WHATSAPP_TOKEN=
STING_WHATSAPP_PHONE_ID=
STING_SMS_URL=
STING_SMS_TOKEN=
STING_EMAIL_FROM=
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# إشعارات الويب: docker compose run --rm api uv run --no-sync python manage.py gen_vapid_keys
STING_VAPID_PUBLIC_KEY=
STING_VAPID_PRIVATE_KEY=
STING_VAPID_SUBJECT=

# رقم السجل التجاري في تمهيد الشروط — بدونه يبقى «[—]»
STING_COMMERCIAL_REGISTRY=
