# متغيّرات البيئة للخادم — نموذج بلا أسرار (0005 §١١٧، §١٢٥، §١٢٦).
# للتطوير: انسخ أسطر البريد إلى backend/.env.email (مستبعَد من git) واملأ المفتاح.
# للإنتاج: تُضبط في Render ← Environment (render.yaml يسردها).

# --- البريد (قناة رمز التحقق) — Brevo SMTP relay ---
STING_EMAIL_FROM=plus@vezano.app
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
# معرّف SMTP من Brevo ← SMTP & API ← SMTP (بصيغة xxxx@smtp-brevo.com)، لا بريد حسابك
EMAIL_HOST_USER=
# مفتاح SMTP من الصفحة نفسها (يبدأ بـ xsmtpsib-) — سرّ
EMAIL_HOST_PASSWORD=

# --- واتساب ثم نصية (اختياري) ---
# STING_WHATSAPP_TOKEN=
# STING_WHATSAPP_PHONE_ID=
# STING_SMS_URL=
# STING_SMS_TOKEN=

# --- إشعارات الويب: uv run python manage.py gen_vapid_keys ---
# STING_VAPID_PUBLIC_KEY=
# STING_VAPID_PRIVATE_KEY=
# STING_VAPID_SUBJECT=mailto:plus@vezano.app
