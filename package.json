{
  "name": "sting-systems",
  "private": true,
  "type": "module",
  "description": "Sting Systems — نقطة بيع وذمم ومخزون بلا اتصال أولاً، وسوق توريد B2B",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "boundaries": "depcruise --config .dependency-cruiser.cjs packages apps",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm boundaries"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "dependency-cruiser": "^17.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
