{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node", "web-bluetooth"],
    "resolveJsonModule": true,
    "strict": true
  },
  "include": [
    ".next/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-gate/types/**/*.ts",
    "e2e/**/*.ts",
    "e2e-gate/**/*.ts",
    "playwright.gate.config.ts",
    "next-env.d.ts",
    "next.config.ts",
    "playwright.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
