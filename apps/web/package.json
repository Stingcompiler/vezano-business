{
  "name": "@sting/web",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js — عام + إدارة + POS + PWA + بوابة زبون + سوق (§٤.٤)",
  "scripts": {
    "dev": "node scripts/prepare-fonts.mjs && next dev -p 3000",
    "build": "node scripts/prepare-fonts.mjs && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "prepare-fonts": "node scripts/prepare-fonts.mjs",
    "e2e:gate": "playwright test -c playwright.gate.config.ts"
  },
  "dependencies": {
    "@sting/contracts": "workspace:*",
    "@sting/design": "workspace:*",
    "@sting/domain": "workspace:*",
    "@sting/platform": "workspace:*",
    "@sting/sync-core": "workspace:*",
    "@sting/ui-web": "workspace:*",
    "@tanstack/react-query": "^5.90.0",
    "dexie": "^4.0.0",
    "next": "^15.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.56.0",
    "@sting/tools-frame-text": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-bluetooth": "^0.0.21",
    "typescript": "^5.6.0"
  }
}
